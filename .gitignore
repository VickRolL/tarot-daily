# ---- 构建产物：随时可再生成 ----
dist/
dist-user/
dist-dev/

# ---- 本机排查产物：体积大，且对构建无价值 ----
# 220 MB —— 截图 / 一次性探针 / 无头浏览器 profile 残留
assets/_debug/
#  82 MB —— 总览拼版与预览图，用 scripts/contact_sheet.py 等再生成
assets/previews/
#  39 MB —— 风格探索期的参考图（非母版，不参与构建）
assets/card-styles/
# 2026-09-19 起 `shot.mjs` 的截图与日志落在这里（scripts/out/*.png / *.log）。
# 28 MB 且随时可重跑（`verify-orb3d.mjs` / `verify-halo.mjs` / `run-flows.mjs`）→ 不入库。
scripts/out/

# ---- 本地保险：v1 冻结快照（134 MB）----
# 它是「随时能拿回一份完整可用产物」的兜底，不随仓库走。
# 详见 _archive/v1-2026-09-19/SNAPSHOT.md
_archive/

# ---- 依赖与缓存 ----
node_modules/
__pycache__/
*.pyc
.vite/
vite.config.js.timestamp-*

# ---- 系统垃圾与临时日志 ----
.DS_Store
Thumbs.db
*.log

